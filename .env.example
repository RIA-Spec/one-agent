# OpenTelemetry / SigNoz Configuration
# Service name that will appear in SigNoz traces
OTEL_SERVICE_NAME=one-agent

# SigNoz OTLP endpoint (default: http://localhost:4318/v1/traces)
# Change this if your SigNoz is running on a different host/port
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# AI SDK / Model API Keys
# Add your API keys here
# ANTHROPIC_API_KEY=your_key_here
# OPENAI_API_KEY=your_key_here

# Action Execution Runtime (AER) Configuration
# Controls which AER to enable: "python" | "bash"
# Only one mode can be active at a time
# - python: Enable Python AER (Code Interpreter approach) - default
# - bash: Enable Bash AER (Unix Philosophy approach)
AER_MODE=python

# File System Configuration for AER
# Root directory for file operations (defaults to project root)
# NODE_FS_ROOT=/path/to/root
# Mount point path visible in Python/Bash (defaults to project root)
# NODE_FS_MOUNT_POINT=/path/to/mount
