# Generate a random secret (example: `openssl rand -base64 32`)
AUTH_SECRET=****

# AI Gateway API key for model access
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=****

# Optional model overrides for one-agent integrations
ONE_AGENT_MODEL=gemini-3.1-pro
ONE_AGENT_REASONING_MODEL=gemini-3.1-pro
ONE_TITLE_MODEL=gemini-3.1-flash-lite
ONE_ARTIFACT_MODEL=gemini-3.1-flash-lite

# Optional Exa API key override used by web search tooling
ONE_EXA_API_KEY=****


# Blob storage token
# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# PostgreSQL connection URL
# https://vercel.com/docs/postgres
POSTGRES_URL=****


# Redis connection URL
# https://vercel.com/docs/redis
REDIS_URL=****
