{
  "name": "one-agent-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "ONE Agent + Chat SDK Integration Monorepo",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter=@one/agent --filter=web dev",
    "build": "pnpm --filter=@one/agent build && pnpm --filter=web build",
    "build:agent": "pnpm --filter=@one/agent build",
    "build:web": "pnpm --filter=web build",
    "fmt": "./packages/one-agent/node_modules/.bin/oxfmt packages/one-agent/src packages/one-act/src packages/one-reason/src",
    "fmt:check": "./packages/one-agent/node_modules/.bin/oxfmt --check packages/one-agent/src packages/one-act/src packages/one-reason/src",
    "repl": "pnpm --filter=@one/agent repl",
    "test": "pnpm --recursive test",
    "typecheck": "pnpm --recursive typecheck",
    "clean": "pnpm --recursive exec rm -rf dist .next node_modules"
  },
  "devDependencies": {},
  "pnpm": {
    "overrides": {
      "ai": "6.0.44",
      "@ai-sdk/provider": "3.0.4"
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
