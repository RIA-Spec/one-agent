# ============================================================
# agent-extension Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# --- ACP Backend ---
# Command to launch the ACP agent backend (default: "claude-agent-acp")
# ONE_AGENT_EXTENSION_ACP_COMMAND=claude-agent-acp

# Model ID passed to the ACP backend (default: "claude-sonnet-4-5-20250929")
# ONE_AGENT_EXTENSION_ACP_MODEL=

# Additional CLI args for the ACP command
# Supports JSON array: ["--permission-mode","acceptEdits"]
# Or shell-like string: --permission-mode acceptEdits
# ONE_AGENT_EXTENSION_ACP_ARGS=

# --- Debug ---
# Debug logging for agent-extension (falls back to ONE_AGENT_DEBUG -> RIA_PROXY_DEBUG -> DEBUG)
# ONE_AGENT_EXTENSION_DEBUG=1
# ONE_AGENT_DEBUG=1

# --- Test ---
# Enable integration tests (set to "1" to run)
# ONE_AGENT_EXTENSION_RUN_INTEGRATION=1

