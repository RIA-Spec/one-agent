# ============================================================
# one-agent Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# --- Model Configuration ---
# Model selection (priority order):
#   ONE_MODEL > ONE_CHAT_MODEL > ONE_AGENT_MODEL > MODEL
# Default: "claude-sonnet-4-5-20250929" (in code)
# ONE_MODEL=
# ONE_CHAT_MODEL=
# ONE_AGENT_MODEL=
# MODEL=

# Custom context window size (default: 200000)
# ONE_MODEL_CONTEXT_WINDOW=

# Provider selection: "vercel" to use Vercel AI Gateway
# ONE_PROVIDER=

# OpenAI-compatible API (used when ONE_PROVIDER is not "vercel")
# OPENAI_BASE_URL=
# OPENAI_API_KEY=

# --- RAS (Reason-able Action Space) ---
# Runtime mode: "python" (default) | "bash"
# RAS_MODE=bash

# File system root for RAS tools (default: project root)
# NODE_FS_ROOT=
# Mount point visible in Python/Bash (default: project root)
# NODE_FS_MOUNT_POINT=

# --- Agent Extension ---
# Enable delegated agent(prompt, config) in RAS tools (default: false)
# ONE_AGENT_EXTENSION_ENABLED=1

# Inject runtime system prompt / tool catalog into delegated agent()
# ONE_AGENT_EXTENSION_INJECT_SYSTEM_PROMPT=1
# ONE_AGENT_EXTENSION_INJECT_TOOLS=1

# --- Compaction ---
# Auto-compact token limit threshold
# ONE_AUTO_COMPACT_TOKEN_LIMIT=

# --- Web Search ---
# Exa API key (ONE_EXA_API_KEY takes priority over EXA_API_KEY)
# ONE_EXA_API_KEY=
# EXA_API_KEY=

# --- Debug ---
# Enable debug logging
# ONE_AGENT_DEBUG=1
# Debug log file path (default: stderr)
# ONE_AGENT_DEBUG_FILE=/tmp/one-agent.log

# --- OpenTelemetry / SigNoz ---
# OTEL_SERVICE_NAME=one-agent
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
