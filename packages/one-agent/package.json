{
  "name": "@one/agent",
  "version": "0.0.0",
  "description": "ONE Agent - AI Agent with code execution runtime (AER).",
  "homepage": "https://github.com/author/library#readme",
  "bugs": {
    "url": "https://github.com/author/library/issues"
  },
  "license": "MIT",
  "author": "Author Name <author.name@mail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/author/library.git"
  },
  "bin": {
    "one-stdio": "./dist/stdio.mjs",
    "reason": "./dist/reason.mjs",
    "one-reason": "./dist/reason.mjs",
    "act": "./dist/act.mjs",
    "one-act": "./dist/act.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./act": "./dist/act.mjs",
    "./reason": "./dist/reason.mjs",
    "./repl": "./dist/repl.mjs",
    "./stdio": "./dist/stdio.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "repl": "tsx --experimental-wasm-stack-switching --env-file=.env ./src/repl.ts",
    "test": "node --env-file=.env --experimental-wasm-stack-switching ./node_modules/vitest/vitest.mjs",
    "run-py": "tsx --experimental-wasm-stack-switching --env-file=.env scripts/run-py.ts",
    "typecheck": "tsc --noEmit",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@one/act": "workspace:*",
    "@one/reason": "workspace:*",
    "@ai-sdk/anthropic": "^3.0.18",
    "@ai-sdk/devtools": "^0.0.6",
    "@mcpc-tech/core": "^0.3.37",
    "@mcpc/code-runner-mcp": "jsr:^0.1.9",
    "@mcpc/mcp-sampling-ai-provider": "jsr:^0.1.21",
    "@mcpc/plugin-markdown-loader": "jsr:^0.0.10",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.69.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.211.0",
    "@opentelemetry/resources": "^2.5.0",
    "@opentelemetry/sdk-node": "^0.211.0",
    "@opentelemetry/semantic-conventions": "^1.39.0",
    "@ai-sdk/openai-compatible": "2.0.35",
    "ai": "^6.0.44",
    "ajv": "^8.17.1",
    "chalk": "^5.6.2",
    "diff": "^8.0.3",
    "gray-matter": "^4.0.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.64",
    "@types/node": "^25.0.3",
    "@vitest/ui": "4.0.17",
    "bumpp": "^10.3.2",
    "oxfmt": "^0.28.0",
    "tsdown": "^0.18.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
