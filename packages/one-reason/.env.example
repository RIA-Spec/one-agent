# ============================================================
# one-reason Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# --- Debug ---
# Verbose mode: print prompts and full responses to stderr
# ONE_REASON_VERBOSE=1

# Debug logging (falls back: ONE_AGENT_DEBUG -> RIA_PROXY_DEBUG -> DEBUG)
# ONE_AGENT_DEBUG=1

# --- Model thinking ---
# Controls how much the model thinks: off/low/medium/high (unset = provider default).
# Forwarded per provider: OpenAI-compatible APIs get `reasoning_effort` (off -> "none"),
# OpenAI gets reasoningEffort (off -> "minimal"), Anthropic sends thinking disabled for
# off and enables thinking per model generation for low/medium/high: adaptive + effort
# on Claude 4.6+/Claude 5, enabled + budget on older Claude models. Needs
# @ai-sdk/anthropic >= 3.0.93 so "off" actually reaches the API.
# Best-effort only: not every model/API honors or accepts these fields.
# Falls back to ONE_REASONING_EFFORT; also readable from REASONING_EFFORT in reason.json.
# ONE_REASON_REASONING_EFFORT=off

# --- Routing mode & Jev backend availability ---
# Execution policy: llm (default) or jev. Jev mode routes decisions to Jev and
# falls back to LLM for free-text examples;
# Jev credentials below only make a Jev backend available.
# ONE_REASON_MODE=llm

# Optional Jev availability switch (1/0, true/false). It does not force Jev mode.
# ONE_REASON_JEV_ENABLED=1

# --- TypeSafe Jev (decision-only evaluation) ---
# Jev can be configured as a standalone decision engine without overriding the primary LLM:
# ONE_REASON_JEV_PROVIDER=typesafe  # or gateway (auto-detected if keys are present)
# TYPESAFE_API_KEY=
# TYPESAFE_AI_API_KEY=
# ONE_REASON_JEV_API_KEY=
# ONE_REASON_JEV_BASE_URL=https://api.typesafe.ai/v1
# ONE_REASON_JEV_MODEL=jev-latest

# --- Vercel AI Gateway Jev ---
# AI_GATEWAY_API_KEY=
# ONE_REASON_GATEWAY_API_KEY=
# ONE_REASON_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v4/ai
# ONE_REASON_GATEWAY_MODEL=typesafe-ai/jev

# --- Legacy provider config (when ONE_REASON_PROVIDER=typesafe|gateway) ---
# ONE_REASON_PROVIDER=typesafe
# ONE_REASON_FALLBACK_PROVIDER=openai-compatible
# ONE_REASON_FALLBACK_OPENAI_API_KEY=
# ONE_REASON_FALLBACK_OPENAI_BASE_URL=
# ONE_REASON_FALLBACK_MODEL=
# If fallback is unset, falls back to the main agent model from `one auth` (one.json).
