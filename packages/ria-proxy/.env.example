# ============================================================
# ria-proxy Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# --- Provider ---
# AI provider: "openai" | "anthropic" | "openai-compatible"
# AIYO_PROVIDER=

# --- Model ---
# Model ID (overrides config file MODEL setting)
# OPENAI_MODEL=

# --- API Keys & Base URLs ---
# OpenAI-compatible
# OPENAI_BASE_URL=
# OPENAI_API_KEY=

# Anthropic
# ANTHROPIC_BASE_URL=
# ANTHROPIC_API_KEY=

# --- Logging ---
# Log directory (default: ~/.aiyo/logs)
# AIYO_LOG_DIR=

# Log level: "debug" | "info" | "warn" | "error" (default: "info")
# AIYO_LOG_LEVEL=info

# Suppress non-error output
# AIYO_QUIET=true

# --- Debug ---
# Debug logging for ria-proxy
# RIA_PROXY_DEBUG=1
# Debug log file path
# RIA_PROXY_DEBUG_FILE=

# Falls back to ONE_AGENT_DEBUG
# ONE_AGENT_DEBUG=1
# ONE_AGENT_DEBUG_FILE=

